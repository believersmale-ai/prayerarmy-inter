# Prayer Army International - Apache rules (Hostinger / any Apache host with mod_rewrite)
Options -Indexes
DirectoryIndex index.html
# Legal page folders must not trigger mod_dir redirects before our page routes.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Missing pages return a real HTTP 404 (rendered by PHP, branded, noindex)
ErrorDocument 404 /api/index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical URLs keep relative scripts and styles working.
  RewriteRule ^(admin|manage|portal)/$ /$1 [L,R=301]

  # Admin dashboard (three equivalent addresses)
  RewriteRule ^(admin|manage|portal)/?$ admin.html [L]

  # Public member shell explains unavailable check-in on non-Node installations.
  RewriteRule ^member/?$ member-portal.html [L]

  # Public pages + agent resources are generated by api/index.php (domain-aware, Markdown on request,
  # structured data, Link headers). /api/ never matches here.
  RewriteRule ^(about|contact|privacy|terms)/$ /$1 [L,R=301]
  RewriteRule ^(index\.html)?$ api/index.php [L]
  RewriteRule ^(about|contact|privacy|terms)$ api/index.php [L]
  RewriteRule ^(index|about|contact|privacy|terms)\.md$ api/index.php [L]
  RewriteRule ^(robots\.txt|llms\.txt|sitemap\.xml|podcast\.xml|mcp)$ api/index.php [L]
  RewriteRule ^\.well-known/mcp/server-card\.json$ api/index.php [L]

  # Developer / deployment files must never be downloadable
  RewriteRule ^(supabase|docs|node_modules|tests|scripts)(/|$) - [F,L]
  RewriteRule ^(server\.js|database\.js|public-auth\.js|church-management\.js|node-(common|auth|content|pages)\.js|package\.json|pnpm-lock\.yaml|metadata\.json|vercel\.json)$ - [F,L]
  RewriteRule \.(md|sql|lock)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "^admin\.html$">
    Header always set X-Frame-Options "DENY"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Compression + caching (images change rarely; CSS/JS revalidate daily)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# Hidden files (.gitignore etc.) are never served
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
